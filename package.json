{
  "name": "@depixy/backend",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc",
    "start": "cross-env NODE_OPTIONS=--enable-source-maps node dist/index.js",
    "preexport:json-schema": "npm run build",
    "export:json-schema": "node dist/config/export.js",
    "test": "cross-env NODE_OPTIONS=--enable-source-maps mocha",
    "lint": "eslint",
    "db:dev": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate --no-hints",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force --skip-generate"
  },
  "author": "Joshua Avalon",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/depixy/backend.git"
  },
  "bugs": {
    "url": "https://github.com/depixy/backend/issues"
  },
  "homepage": "https://github.com/depixy/backend#readme",
  "imports": {
    "#app": {
      "import": "./dist/app/index.js"
    },
    "#config": {
      "import": "./dist/config/index.js"
    },
    "#error": {
      "import": "./dist/error/index.js"
    },
    "#plugins/*": {
      "import": "./dist/plugins/*/index.js"
    },
    "#routes": {
      "import": "./dist/routes/index.js"
    },
    "#schema": {
      "import": "./dist/schema/index.js"
    },
    "#schema/*": {
      "import": "./dist/schema/*/index.js"
    },
    "#swagger": {
      "import": "./dist/swagger/index.js"
    },
    "#utils": {
      "import": "./dist/utils/index.js"
    }
  },
  "exports": {
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    }
  },
  "devDependencies": {
    "@joshuaavalon/eslint-config-typescript": "^9.2.2",
    "@types/chai": "^5.0.1",
    "@types/config": "^3.3.5",
    "@types/luxon": "^3.4.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.1",
    "@types/set-cookie-parser": "^2.4.10",
    "@types/sodium-native": "^2.3.9",
    "chai": "^5.1.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "mocha": "^11.1.0",
    "prisma": "^6.3.1",
    "rimraf": "^6.0.1",
    "set-cookie-parser": "^2.7.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.744.0",
    "@casl/ability": "^6.7.3",
    "@casl/prisma": "^1.5.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/secure-session": "^8.1.1",
    "@fastify/swagger": "^9.4.2",
    "@prisma/client": "^6.3.1",
    "@scalar/fastify-api-reference": "^1.25.115",
    "@sinclair/typebox": "^0.34.15",
    "argon2": "^0.41.1",
    "config": "^3.3.12",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "js-yaml": "^4.1.0",
    "luxon": "^3.5.0",
    "pino-pretty": "^13.0.0",
    "sodium-native": "^4.3.1"
  }
}
