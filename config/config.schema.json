{
  "$id": "https://raw.githubusercontent.com/depixy/backend/refs/heads/master/config/config.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Depixy Backend Configuration",
  "type": "object",
  "properties": {
    "database": {
      "additionalProperties": false,
      "description": "All database related configuration",
      "title": "Database Configuration",
      "type": "object",
      "properties": {
        "url": {
          "description": "Example: file:./dev.db",
          "title": "Database connection string",
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "feature": {
      "additionalProperties": false,
      "description": "All features related configuration",
      "title": "Feature Configuration",
      "type": "object",
      "properties": {}
    },
    "logging": {
      "additionalProperties": false,
      "description": "All logging related configuration",
      "title": "Logging Configuration",
      "type": "object",
      "properties": {
        "database": {
          "title": "Log Level",
          "anyOf": [
            {
              "const": "debug",
              "type": "string"
            },
            {
              "const": "info",
              "type": "string"
            },
            {
              "const": "warn",
              "type": "string"
            },
            {
              "const": "error",
              "type": "string"
            },
            {
              "const": "silent",
              "type": "string"
            }
          ]
        },
        "format": {
          "title": "Log format",
          "anyOf": [
            {
              "const": "pretty",
              "type": "string"
            },
            {
              "const": "json",
              "type": "string"
            }
          ]
        },
        "level": {
          "description": "See https://github.com/depixy/backend/blob/master/src/config/README.md",
          "title": "Log Level",
          "anyOf": [
            {
              "const": "trace",
              "type": "string"
            },
            {
              "const": "debug",
              "type": "string"
            },
            {
              "const": "info",
              "type": "string"
            },
            {
              "const": "warn",
              "type": "string"
            },
            {
              "const": "error",
              "type": "string"
            },
            {
              "const": "fatal",
              "type": "string"
            },
            {
              "const": "silent",
              "type": "string"
            }
          ]
        },
        "request": {
          "title": "Log Level",
          "anyOf": [
            {
              "const": "all",
              "type": "string"
            },
            {
              "const": "forbidden",
              "type": "string"
            },
            {
              "const": "error",
              "type": "string"
            },
            {
              "const": "silent",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "database",
        "format",
        "level",
        "request"
      ]
    },
    "network": {
      "additionalProperties": false,
      "description": "All network related configuration",
      "title": "Network Configuration",
      "type": "object",
      "properties": {
        "ipHeader": {
          "description": "Determine which header to use for client ip.",
          "minLength": 1,
          "title": "Client IP header",
          "type": "string"
        },
        "trustProxy": {
          "description": "Enable if the upstream services are trusted, i.e. reverse proxies.",
          "title": "Trust proxy headers",
          "type": "boolean"
        }
      },
      "required": [
        "trustProxy"
      ]
    },
    "session": {
      "additionalProperties": false,
      "description": "All session related configuration",
      "title": "Session Configuration",
      "type": "object",
      "properties": {
        "expiry": {
          "description": "Number of days for the session to be expired",
          "minimum": 1,
          "type": "number"
        },
        "salt": {
          "maxLength": 16,
          "minLength": 16,
          "type": "string"
        },
        "secret": {
          "minLength": 32,
          "type": "string"
        }
      },
      "required": [
        "expiry",
        "salt",
        "secret"
      ]
    },
    "storage": {
      "additionalProperties": false,
      "description": "All storage related configuration",
      "title": "Storage Configuration",
      "type": "object",
      "properties": {
        "image": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "accessKey": {
                  "minLength": 1,
                  "type": "string"
                },
                "bucket": {
                  "minLength": 1,
                  "type": "string"
                },
                "endpoint": {
                  "minLength": 1,
                  "type": "string"
                },
                "region": {
                  "minLength": 1,
                  "type": "string"
                },
                "secretKey": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": {
                  "const": "s3",
                  "type": "string"
                }
              },
              "required": [
                "accessKey",
                "bucket",
                "secretKey",
                "type"
              ]
            },
            {
              "type": "object",
              "properties": {
                "baseDir": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": {
                  "const": "local",
                  "type": "string"
                }
              },
              "required": [
                "baseDir",
                "type"
              ]
            }
          ]
        }
      },
      "required": [
        "image"
      ]
    }
  },
  "required": [
    "database",
    "feature",
    "logging",
    "network",
    "session",
    "storage"
  ]
}